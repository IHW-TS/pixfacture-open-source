{
  "name": "facturation-enterprise-sale-final-ui",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/check-legal-env.mjs && node scripts/check-csp.mjs && node scripts/check-no-inline-styles.mjs",
    "legal:check": "node scripts/check-legal-env.mjs",
    "csp:check": "node scripts/check-csp.mjs",
    "style:inline:check": "node scripts/check-no-inline-styles.mjs",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "start": "next start -p 3000",
    "lint": "eslint src middleware.ts next.config.js --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\"",
    "check:active-sources": "cd .. && node scripts/audits/active_frontend_sources.mjs --check",
    "check:links": "node scripts/check_official_links.mjs",
    "test:unit": "node --test tests/unit/*.test.js",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/public-accessibility.spec.ts",
    "scan:secrets": "cd .. && bash scripts/run_gitleaks.sh detect --source . --config .gitleaks.toml --no-git --redact"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.576.0",
    "motion": "^12.34.3",
    "next": "^15.5.18",
    "next-themes": "^0.4.6",
    "react": "18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.72.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.1",
    "vaul": "^0.9.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.55.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.18",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.5.18",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion": "1.1.14",
    "fast-uri": "3.1.2",
    "postcss": "$postcss",
    "uuid": "14.0.0",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "readdirp": {
      "picomatch": "2.3.2"
    }
  }
}
