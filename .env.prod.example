# Production (placeholders only, no secrets)
APP_ENV=prod
ENV_FILE=/opt/facturation/env/prod.env
PUBLIC_BASE_URL=https://app.example.com
# Optional: front URL when it differs from PUBLIC_BASE_URL (multi-domain)
FRONTEND_BASE_URL=
# API origin must be host only (no /api). Leave empty if front+api share the same domain.
NEXT_PUBLIC_API_ORIGIN=https://app.example.com
NEXT_PUBLIC_SOURCE_CODE_URL=https://github.com/IHW-TS/pixfacture-open-source
# API prefix defaults to /api
NEXT_PUBLIC_API_PREFIX=/api
# Optionnel: override pour dev seulement. En prod, laisser vide.
# (origin only, no /api suffix). Les appels ajoutent deja /api.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SHOW_DEV_CONNECTORS=false
NEXT_PUBLIC_HIDE_DEV_PAGES=true
NEXT_PUBLIC_ENABLE_PDP_INTEGRATION=false
NEXT_PUBLIC_ENABLE_PPF_DIRECTORY=false
NEXT_PUBLIC_ENABLE_EINVOICING_PAGES=false
NEXT_PUBLIC_COMPLIANCE_CLAIM_LEVEL=export_only
NEXT_PUBLIC_MVP_COMMERCIAL_MODE=on
CORS_ORIGINS=https://app.example.com
TRUSTED_HOSTS=app.example.com
# Proxy reverse (Traefik/LB) : CIDR des proxies autorisés pour X-Forwarded-*.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,CHANGE_ME_TRAEFIK_OR_LB_CIDR
# Forcer la confiance X-Forwarded-* quel que soit le peer (déconseillé).
TRUSTED_PROXY_ALWAYS=false
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_COMPANY_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_COMPANY_CAPITAL=
NEXT_PUBLIC_LEGAL_COMPANY_RCS_CITY=
NEXT_PUBLIC_LEGAL_COMPANY_RCS_NUMBER=
NEXT_PUBLIC_LEGAL_COMPANY_VAT_NUMBER=
NEXT_PUBLIC_LEGAL_COMPANY_ADDRESS=
NEXT_PUBLIC_LEGAL_COMPANY_EMAIL=
NEXT_PUBLIC_LEGAL_COMPANY_PHONE=
NEXT_PUBLIC_LEGAL_PUBLISHER_DIRECTOR=
NEXT_PUBLIC_LEGAL_HOSTING_PROVIDER_NAME=
NEXT_PUBLIC_LEGAL_HOSTING_PROVIDER_ADDRESS=
NEXT_PUBLIC_LEGAL_HOSTING_PHONE=
NEXT_PUBLIC_LEGAL_PRIVACY_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_DPO_EMAIL=
NEXT_PUBLIC_LEGAL_DPO_DESIGNATED=false
NEXT_PUBLIC_LEGAL_SUPPORT_EMAIL=
NEXT_PUBLIC_SALES_SLA_DAYS=2
NEXT_PUBLIC_LEGAL_LAST_UPDATED=2026-07-11
NEXT_PUBLIC_LEGAL_DOC_VERSION_TERMS=2026-07-11
NEXT_PUBLIC_LEGAL_DOC_VERSION_CGV=2026-07-11
NEXT_PUBLIC_LEGAL_DOC_VERSION_DPA=2026-07-11
NEXT_PUBLIC_LEGAL_DOC_VERSION_PRIVACY=2026-07-11
NEXT_PUBLIC_LEGAL_DOC_VERSION_COOKIES=2026-07-11
# Empreintes des exports canoniques effectivement publiés. Ne pas réutiliser
# une empreinte après modification du texte, même si la version reste identique.
LEGAL_DOC_SHA256_TERMS=7290601f7104b167678e1e9a8a51905080cdde443b7c7104e669d0b892671595
LEGAL_DOC_SHA256_DPA=8406bd32c5e3d640ffc9fcf2e6eccc69d4f24f1f252850a9296cb77e1327488a
LEGAL_DOC_CANONICAL_TERMS_FILE=/opt/facturation/shared/legal/terms-2026-07-11.txt
LEGAL_DOC_CANONICAL_DPA_FILE=/opt/facturation/shared/legal/dpa-2026-07-11.txt
LEGAL_TERMS_ACCEPTANCE_REQUIRED=true
LEGAL_DPA_ACCEPTANCE_REQUIRED=true
# Gate public large: l'acceptation in-app des CGU/CGV et DPA doit rester active.
# Optionnel: compléments légaux / compat anciennes variables
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_DPO_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_LEGAL_RCS=
NEXT_PUBLIC_LEGAL_VAT_NUMBER=
NEXT_PUBLIC_LEGAL_DIRECTOR_PUBLICATION=
NEXT_PUBLIC_LEGAL_HOSTING_PROVIDER=
NEXT_PUBLIC_LEGAL_HOSTING_LOCATION=
NEXT_PUBLIC_LEGAL_HOSTING_WEBSITE=
NEXT_PUBLIC_LEGAL_JURISDICTION=
NEXT_PUBLIC_LEGAL_EMAIL_PROVIDER=
NEXT_PUBLIC_LEGAL_EMAIL_LOCATION=
NEXT_PUBLIC_LEGAL_PAYMENT_PROVIDER=
NEXT_PUBLIC_LEGAL_PAYMENT_LOCATION=
NEXT_PUBLIC_LEGAL_MONITORING_PROVIDER=
NEXT_PUBLIC_LEGAL_MONITORING_LOCATION=
NEXT_PUBLIC_LEGAL_PDP_PROVIDER=
NEXT_PUBLIC_LEGAL_PDP_LOCATION=
NEXT_PUBLIC_LEGAL_PDF_CGV_URL=
NEXT_PUBLIC_LEGAL_PDF_CGU_URL=
NEXT_PUBLIC_LEGAL_PDF_DPA_URL=
# Mesure d'audience désactivée par défaut. Ne renseigner ces variables qu'après
# mise à jour de la politique cookies et qualification du parcours de consentement.
PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_COOKIES_LIST=
NEXT_PUBLIC_COOKIES_DURATIONS=
NEXT_PUBLIC_RPO=
NEXT_PUBLIC_RTO=
NEXT_PUBLIC_STATUS_PAGE_URL=
NEXT_PUBLIC_FACTURX_SPEC_VERSION=1.0.8
# Calendrier e-invoicing (front) - format YYYY-MM-DD
NEXT_PUBLIC_EINVOICING_RECEPTION_DATE=2026-09-01
NEXT_PUBLIC_EINVOICING_EMISSION_DATE_GE_ETI=2026-09-01
NEXT_PUBLIC_EINVOICING_EMISSION_DATE_PME=2027-09-01
# Specification DGFiP (front)
NEXT_PUBLIC_DGFIP_SPEC_VERSION=B2B v3.1
NEXT_PUBLIC_DGFIP_SPEC_DATE=2025-10-31
# Dates de mise a jour affichees sur les pages marketing / trust center (format YYYY-MM-DD).
NEXT_PUBLIC_OFFICIAL_SOURCES_LAST_UPDATED=2026-07-10
NEXT_PUBLIC_TRUST_CENTER_LAST_UPDATED=2026-07-10
SENTRY_SEND_PII=false
SENTRY_SEND_DEFAULT_PII=false

TRAEFIK_DOMAIN=app.example.com
EMAIL_LETSENCRYPT=admin@example.com
# CSP stricte (enforced, sans unsafe-inline) via Traefik.
CSP_STRICT=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sass_facturation
DATABASE_RUNTIME_ROLE=pixfacture_runtime
DATABASE_URL=postgresql://pixfacture_runtime:CHANGE_ME_RUNTIME_PASSWORD@db:5432/sass_facturation
# En production, URL-encoder le mot de passe s'il contient des caractères réservés.
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_URL_ENCODED_REDIS_PASSWORD@redis:6379/0
DISABLE_RATE_LIMITS=false
# Break-glass uniquement en incident court et documente; interdit par defaut.
RATE_LIMITS_BREAK_GLASS=false
# Genere une cle forte (ex): python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_LONG_RANDOM_32_CHARS_MIN
PDP_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_32_CHARS_MIN
# Option rotation (keyring): PDP_ENCRYPTION_KEYS=v1:secret1,v2:secret2
PDP_ENCRYPTION_KEYS=CHANGE_ME
PDP_ENCRYPTION_KID=
PDP_STORE_RAW_JSON=false
PDP_RAW_JSON_RETENTION_DAYS=7
PDP_RAW_JSON_MAX_BYTES=8192
# Auth/session (recommande en prod: cookies HttpOnly)
AUTH_COOKIE_MODE=true
NEXT_PUBLIC_AUTH_COOKIE_MODE=true
BEARER_MODE=false
NEXT_PUBLIC_BEARER_MODE=false
# Optional: persist bearer tokens per tab (sessionStorage) when bearer mode is enabled.
NEXT_PUBLIC_BEARER_TOKEN_PERSIST=
PASSWORD_MIN_LENGTH=12
# Si REQUIRE_EMAIL_VERIFICATION=true, alors SMTP_ENABLED=true + SMTP_* obligatoires.
REQUIRE_EMAIL_VERIFICATION=true
REGISTER_DAILY_MAX_PER_IP=5
REGISTER_DAILY_GLOBAL_MAX=200
REGISTER_DAILY_WINDOW_SECONDS=86400
TRIAL_LIFECYCLE_CLEANUP_ENABLED=true
TRIAL_LIFECYCLE_NOTIFICATIONS_ENABLED=true
TRIAL_INACTIVE_ANONYMIZE_DAYS=30
TRIAL_PRE_ANONYMIZATION_NOTICE_DAYS=7
TRIAL_LIFECYCLE_CLEANUP_BATCH_SIZE=100
INVOICE_COMPLIANCE_STRICT=false
# MFA reste facultative pour tous les comptes, y compris les administrateurs
# et opérateurs plateforme. Chaque utilisateur l'active depuis son compte.
MFA_ENFORCE_PLATFORM_ADMINS=false
# Admin plateforme (promotion manuelle via CLI).
# PLATFORM_ADMIN_ENABLED=true
PLATFORM_BOOTSTRAP_TOKEN=
JOBS_SYNC=false
JOBS_QUEUE_NAME=default
JOBS_TIMEOUT_SECONDS=900
JOBS_RESULT_TTL=3600
# Supervision strictement locale du collatéral Seqino (aucun appel fournisseur).
SEQINO_TOKEN_INVENTORY_INTERVAL_SECONDS=300
SEQINO_TOKEN_INVENTORY_EXPIRY_BATCH_SIZE=500
PERIODIC_HEARTBEAT_MIN_TTL_SECONDS=600
ACTION_LOG_RETENTION_DAYS=365
DIRECTORY_SYNC_INTERVAL_SECONDS=86400
ENABLE_HTTP_GENERIC_CONNECTOR=false
# Seqino requis en prod/staging ? true => SEQINO_* obligatoires, false => optionnel (export/other PDP)
REQUIRE_SEQINO_IN_PROD=false
# Seqino e-reporting mode: payments_only | full | seqino_v1 (legacy)
EREPORTING_SEQINO_MODE=payments_only
# Webhooks
WEBHOOK_TIMEOUT_SECONDS=8
WEBHOOK_DNS_TIMEOUT_SECONDS=3
# Facultatif : vide = tout domaine client HTTPS dont toutes les IP sont publiques.
# Exemples restrictifs : hooks.client.fr,*.webhooks.example
CUSTOMER_WEBHOOK_ALLOWED_HOSTS=
# FEC export defaults
FEC_JOURNAL_CODE=VE
FEC_JOURNAL_LABEL=Ventes
FEC_ACCOUNT_CUSTOMER=411
FEC_ACCOUNT_REVENUE=706
FEC_ACCOUNT_VAT=44571
# Requis en prod/staging (SSRF protection)
PLATFORM_ALLOWED_HOSTS=pa.seqino.com,*.seqino.dev,sandbox-oauth.piste.gouv.fr,sandbox-api.piste.gouv.fr

# Cookies
COOKIE_SAMESITE=lax
# Cross-site (front + API sur domaines differents) :
# - COOKIE_SAMESITE=none
# - COOKIE_SECURE=true (requis par les navigateurs pour SameSite=None)
# - CORS_ORIGINS doit contenir le domaine du front
COOKIE_DOMAIN=
# COOKIE_SECURE=true
STRICT_COOKIE_CONFIG=true

# Liens publics documents / portail client
INVOICE_PUBLIC_LINK_TTL_DAYS=30
INVOICE_PUBLIC_RATE_LIMIT_PER_MINUTE=120
QUOTE_PUBLIC_LINK_TTL_DAYS=30
QUOTE_PUBLIC_RATE_LIMIT_PER_MINUTE=120
CUSTOMER_PORTAL_LINK_TTL_DAYS=30
CUSTOMER_PORTAL_RATE_LIMIT_PER_MINUTE=120
BREVO_WEBHOOK_MAX_BYTES=262144
BREVO_WEBHOOK_MAX_EVENTS=100

# Storage (S3/MinIO ou local)
STORAGE_PROVIDER=s3
STORAGE_LOCAL_PATH=/data/storage
# STORAGE_BUCKET (ou S3_BUCKET)
STORAGE_BUCKET=CHANGE_ME
# Archivage probant requis avant ouverture publique large.
ENABLE_LEGAL_ARCHIVE=true
S3_ENDPOINT=CHANGE_ME
S3_REGION=CHANGE_ME
# Alias OVH/S3 acceptés par l'app et les scripts ops:
# S3_ENDPOINT_URL, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY.
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false
# Requis si ENABLE_LEGAL_ARCHIVE=true: Object Lock + versioning activés sur le bucket.
S3_OBJECT_LOCK_ENABLED=true
S3_BUCKET_VERSIONING=true
S3_KMS_KEY_ID=CHANGE_ME
S3_OBJECT_LOCK_MODE=COMPLIANCE
S3_OBJECT_LOCK_RETENTION_DAYS=3650
STORAGE_COST_PER_GIB_EUR=0.023

# SMTP requis si REQUIRE_EMAIL_VERIFICATION=true ou si vous voulez envoyer des emails facture.
SMTP_ENABLED=true
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=YOUR_SMTP_FROM
SALES_EMAIL=
INVOICE_EMAIL_RATE_LIMIT_PER_HOUR=30
INVOICE_EMAIL_RATE_LIMIT_PER_DAY=200

# Relances automatiques factures (dunning)
INVOICE_FOLLOWUP_SCHEDULE_DAYS=-2,3,10
INVOICE_FOLLOWUP_MIN_INTERVAL_HOURS=24
INVOICE_FOLLOWUP_ATTACH_PDF=false

# Stripe: activer BILLING_ENABLED=true (ou SUBSCRIPTION_REQUIRED=true) pour l'abonnement.
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
STRIPE_WEBHOOK_MAX_BYTES=262144
STRIPE_PRICE_STARTER_MONTHLY=CHANGE_ME
# OBLIGATOIRE si l’offre annuelle est activée dans le front
STRIPE_PRICE_STARTER_YEARLY=CHANGE_ME
STRIPE_PRICE_PRO_MONTHLY=CHANGE_ME
# OBLIGATOIRE si l’offre annuelle est activée dans le front
STRIPE_PRICE_PRO_YEARLY=CHANGE_ME
# Legacy fallback (monthly)
STRIPE_PRICE_STARTER=CHANGE_ME
STRIPE_PRICE_PRO=CHANGE_ME
STRIPE_PRICE_ENTERPRISE=CHANGE_ME
STRIPE_PRICE_TOKENS_100=CHANGE_ME
STRIPE_PRICE_TOKENS_500=CHANGE_ME
STRIPE_PRICE_TOKENS_1000=CHANGE_ME
STRIPE_PRICE_TOKENS_5000=CHANGE_ME
STRIPE_SUCCESS_URL=https://app.votredomaine.tld/billing/success
STRIPE_CANCEL_URL=https://app.votredomaine.tld/billing/cancel
# Configuration Billing Portal dédiée, active, avec subscription_update=false.
# Les changements de formule passent par Checkout afin de réserver les 50 jetons Pro avant paiement.
STRIPE_CUSTOMER_PORTAL_RETURN_URL=https://app.votredomaine.tld/app/billing
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=bpc_CHANGE_ME_SAFE_NO_PLAN_UPDATE
STRIPE_TOKENS_SUCCESS_URL=
STRIPE_TOKENS_CANCEL_URL=

# Paiement des factures (portail client)
STRIPE_INVOICE_PAYMENTS_ENABLED=false

# Legacy non utilise par l'offre actuelle. Garder a 0: le produit utilise des jetons.
BILLING_INCLUDED_FLOWS_STARTER=0
BILLING_INCLUDED_FLOWS_PRO=0
SEQINO_WELCOME_TOKENS_PRO=50
BILLING_OVERAGE_RATE_EUR=0.25
# strict | best_effort
BILLING_OVERAGE_POLICY=strict
# Optionnel: coût réel Seqino par flux (si connu)
SEQINO_COST_PER_FLOW_EUR=

PISTE_CLIENT_ID=CHANGE_ME
PISTE_CLIENT_SECRET=CHANGE_ME
PISTE_TOKEN_URL=https://oauth.piste.gouv.fr/api/oauth/token
CHORUS_API_BASE=https://api.piste.gouv.fr
CHORUS_SUBMIT_PATH=/cpro/factures/v1/deposer/flux
CHORUS_STATUS_PATH=/cpro/transverses/v1/consulterCRDetaille
# Valeur non secrète à confirmer avec la qualification Chorus/PISTE.
CHORUS_SUBMIT_EXTRA_JSON={"syntaxeFlux":"IN_DP_E2_CII_FACTURX"}
# Aucun CHORUS_CPRO_ACCOUNT global: le login:password encodé en base64 attendu
# dans le header cpro-account est chiffré par tenant lors de la création contrôlée.
# Seqino (mode sponsor géré par le SaaS, aucun identifiant client)
SEQINO_BASE_URL=https://pa.seqino.com/api
SEQINO_ACCESS_TOKEN=CHANGE_ME
SEQINO_SPONSOR_ID=CHANGE_ME
SEQINO_WEBHOOK_SECRET=CHANGE_ME
SEQINO_WEBHOOK_MAX_AGE_SECONDS=300

# --------- PPF Directory (Annuaire) ----------
PPF_DIRECTORY_BASE_URL=https://ppf.example.com/annuaire
PPF_DIRECTORY_CLIENT_ID=CHANGE_ME
PPF_DIRECTORY_CLIENT_SECRET=CHANGE_ME
PPF_DIRECTORY_TOKEN_URL=https://ppf.example.com/oauth/token
PPF_DIRECTORY_AUDIENCE=

# PDF/A-3 mode: off | best_effort | strict
# best_effort: convert+validate when tools are available; warnings if validation missing.
# strict: requires ghostscript + icc-profiles-free + verapdf, app fails to boot if missing.
FACTURX_SPEC_VERSION=1.0.8
FACTURX_STRICT=true
FACTURX_ALLOW_FALLBACK=false
FACTURX_PDFA_MODE=best_effort
# Legacy (deprecated): FACTURX_PDFA_VALIDATION=strict
UBL_EXPORT_ENABLED=false
EINVOICING_EXPORT_ONLY=false
# Liste exacte, séparée par des virgules. Wildcard interdit en prod/staging.
CONNECTED_MODE_ALLOWED_TENANT_IDS=CHANGE_ME_TENANT_UUID
# Fournisseurs exacts autorisés pour ce pilote: seqino, choruspro ou ppf.
# Pour un pilote Chorus isolé, conserver uniquement choruspro.
CONNECTED_MODE_ALLOWED_PROVIDERS=choruspro
# Legacy e-invoicing API (/api/einvoicing/*, /api/e-invoicing/pdp/*).
# Default false in prod/staging to reduce attack surface.
ENABLE_LEGACY_EINVOICING_API=false

# --------- Volumétrie / jobs / DB runtime ----------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_APPLICATION_NAME=pixfacture-api
JOBS_QUEUE_CRITICAL=critical
JOBS_QUEUE_EMAILS=emails
JOBS_QUEUE_PDF=pdf
JOBS_QUEUE_EXPORTS=exports
JOBS_QUEUE_INTEGRATIONS=integrations
JOBS_QUEUE_LOW=low
MAX_INVOICE_LINES=200
MAX_EXPORTS_PER_DAY=20
MAX_API_KEYS_PER_TENANT=10
MAX_CUSTOMERS_IMPORT_ROWS=5000
MAX_PRODUCTS_IMPORT_ROWS=5000
# Images de production immuables. Remplacer chaque digest après build, scan et
# publication par la CI; les tags seuls sont refusés par le gate public.
BACKEND_IMAGE=registry.example.com/pixfacture/backend@sha256:CHANGE_ME_64_HEX
FRONTEND_IMAGE=registry.example.com/pixfacture/frontend@sha256:CHANGE_ME_64_HEX
TRAEFIK_IMAGE=traefik@sha256:CHANGE_ME_64_HEX
POSTGRES_IMAGE=postgres@sha256:CHANGE_ME_64_HEX
REDIS_IMAGE=redis@sha256:CHANGE_ME_64_HEX
DOCKER_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy@sha256:CHANGE_ME_64_HEX
