APP_ENV=prod
SECRET_KEY=CHANGE_ME_WITH_32_CHARS_MIN
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/sass_facturation
REDIS_URL=redis://redis:6379/0
REGISTER_DAILY_MAX_PER_IP=0
REGISTER_DAILY_GLOBAL_MAX=0
REGISTER_DAILY_WINDOW_SECONDS=86400
MFA_ENFORCE_PLATFORM_ADMINS=false

# Cycle de vie des essais. L'expiration fonctionnelle reste fixee par trial_end
# a J+7. Commencer par le dry-run du scheduler de retention avant d'activer.
TRIAL_LIFECYCLE_CLEANUP_ENABLED=false
TRIAL_LIFECYCLE_NOTIFICATIONS_ENABLED=false
TRIAL_UNVERIFIED_PURGE_DAYS=7
TRIAL_INACTIVE_ANONYMIZE_DAYS=30
# Notification envoyee 7 jours avant l'anonymisation au plus tot.
TRIAL_PRE_ANONYMIZATION_NOTICE_DAYS=7
# Marge avant purge des invitations non consommees expirees ou revoquees.
DEMO_INVITATION_RETENTION_DAYS=30
TRIAL_LIFECYCLE_CLEANUP_BATCH_SIZE=100
# IDs separes par des virgules (legal hold / investigation / support).
TRIAL_CLEANUP_EXCLUDED_TENANT_IDS=

PUBLIC_BASE_URL=https://app.example.com
FRONTEND_BASE_URL=https://app.example.com
NEXT_PUBLIC_API_ORIGIN=https://app.example.com
NEXT_PUBLIC_SOURCE_CODE_URL=https://github.com/IHW-TS/pixfacture-open-source
NEXT_PUBLIC_API_PREFIX=/api
CORS_ORIGINS=https://app.example.com
TRUSTED_HOSTS=app.example.com,localhost,127.0.0.1

# Recommended when storing tenant connector secrets in the app.
PDP_ENCRYPTION_KEY=CHANGE_ME_DISTINCT_FROM_SECRET_KEY

# Billing
BILLING_ENABLED=true
SUBSCRIPTION_REQUIRED=false
SEQINO_WELCOME_TOKENS_PRO=50
SALES_EMAIL=sales@example.com

# Stripe
STRIPE_PUBLIC_KEY=pk_test_CHANGE_ME
STRIPE_SECRET_KEY=CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET
STRIPE_WEBHOOK_MAX_BYTES=262144

# Stripe redirect URLs
STRIPE_SUCCESS_URL=https://app.example.com/app/billing?checkout=success
STRIPE_CANCEL_URL=https://app.example.com/app/billing?checkout=cancel
STRIPE_CUSTOMER_PORTAL_RETURN_URL=https://app.example.com/app/billing
# Configuration Billing Portal active avec subscription_update=false.
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=bpc_CHANGE_ME_SAFE_NO_PLAN_UPDATE
STRIPE_TOKENS_SUCCESS_URL=https://app.example.com/app/billing?topup=success
STRIPE_TOKENS_CANCEL_URL=https://app.example.com/app/billing?topup=cancel

# Stripe subscriptions
STRIPE_PRICE_STARTER_MONTHLY=price_CHANGE_ME_STARTER_MONTHLY
STRIPE_PRICE_STARTER_YEARLY=price_CHANGE_ME_STARTER_YEARLY
STRIPE_PRICE_PRO_MONTHLY=price_CHANGE_ME_PRO_MONTHLY
STRIPE_PRICE_PRO_YEARLY=price_CHANGE_ME_PRO_YEARLY

# Optional / contact sales only
STRIPE_PRICE_ENTERPRISE=

# Stripe one-time token packs
STRIPE_PRICE_TOKENS_100=price_CHANGE_ME_TOKENS_100
STRIPE_PRICE_TOKENS_500=price_CHANGE_ME_TOKENS_500
STRIPE_PRICE_TOKENS_1000=price_CHANGE_ME_TOKENS_1000
STRIPE_PRICE_TOKENS_5000=price_CHANGE_ME_TOKENS_5000

# Optional: client invoice payments
STRIPE_INVOICE_PAYMENTS_ENABLED=false

# Optional: seed a smoke tenant with connectors marked configured.
# Seqino: either enable demo mode or provide test credentials below.
SEQINO_DEMO_MODE=false
SEQINO_BASE_URL=
SEQINO_SPONSOR_ID=
SEQINO_WEBHOOK_SECRET=
SEQINO_WEBHOOK_MAX_AGE_SECONDS=300
SEQINO_ACCESS_TOKEN=CHANGE_ME
SEQINO_API_KEY=

# Chorus / PISTE sandbox
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=CHANGE_ME_PISTE_CLIENT_SECRET
PISTE_TOKEN_URL=https://sandbox-oauth.piste.gouv.fr/api/oauth/token
CHORUS_API_BASE=https://sandbox-api.piste.gouv.fr
CHORUS_SUBMIT_PATH=/cpro/factures/v1/deposer/flux
CHORUS_STATUS_PATH=/cpro/transverses/v1/consulterCRDetaille
CHORUS_SUBMIT_EXTRA_JSON={"syntaxeFlux":"IN_DP_E2_CII_FACTURX"}
# Le header cpro-account est un login:password encodé en base64. Il doit être
# chiffré par tenant et ne doit jamais être placé dans cet environnement global.
